# ─────────────────────────────────────────────────────────────────
# RiverFlow Monitor — environment variables (safe placeholders)
# Copy to .env / set in your shell / configure in your host's dashboard.
# Never commit real credentials.
# ─────────────────────────────────────────────────────────────────

# ── Backend (Python / FastAPI) — all optional ─────────────────────

# Restrict CORS to exact origins (default: allow all, for local dev & tunnels)
# RIVERFLOW_CORS_ORIGINS=https://your-frontend.example,https://another.example

# Serve the frontend from a custom build directory (default: frontend/dist)
# RIVERFLOW_FRONTEND_DIST=/path/to/frontend/dist

# Optional backend session auth (alternative to Firebase login).
# Empty RIVERFLOW_AUTH_USER = disabled. Use long random values.
# RIVERFLOW_AUTH_USER=
# RIVERFLOW_AUTH_PASSWORD=
# RIVERFLOW_AUTH_SECRET=

# ── Frontend (Vite / React) — optional ────────────────────────────

# Point the webapp at a remote Python backend instead of same-origin
# (e.g. a tunnel or cloud deployment). Without it, the app talks to the
# server that serves it, or falls back to clearly-labeled demo mode.
# VITE_API_BASE_URL=https://your-backend.example

# Firebase web config is committed by design in frontend/src/services/firebase.ts
# (it is public identifier data, protected by Firebase security rules).
# No Firebase secrets belong in this file.
